rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Public read for crews; authenticated crew leaders/members can update
    match /crews/{crewId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Members collection
    match /members/{memberId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Connection testing
    match /system/{docId} {
      allow read, write: if true;
    }
  }
}
